{
  "name": "nafuda-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && wrangler deploy --config wrangler-bundle.toml --dry-run --outdir dist/bundle && node -e \"const fs=require('fs');fs.copyFileSync('dist/bundle/worker-entry.js','dist/client/_worker.js');fs.rmSync('dist/client/wrangler.json',{force:true});fs.rmSync('.wrangler/deploy/config.json',{force:true});\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply nafuda-db-dev --local --config wrangler-dev.toml",
    "db:migrate:staging": "wrangler d1 migrations apply nafuda-db-staging --remote --env preview",
    "db:migrate:prod": "wrangler d1 migrations apply nafuda-db-prod --remote",
    "db:studio": "drizzle-kit studio",
    "db:studio:staging": "drizzle-kit studio --config drizzle.config.staging.ts",
    "auth:generate": "npx auth generate",
    "realtime:deploy:staging": "wrangler deploy --config realtime/wrangler.toml --env=\"\"",
    "realtime:deploy:prod": "wrangler deploy --config realtime/wrangler.toml --env production",
    "realtime:tail:staging": "wrangler tail --config realtime/wrangler.toml --env=\"\"",
    "realtime:tail:prod": "wrangler tail --config realtime/wrangler.toml --env production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "better-auth": "1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "emblor": "^1.4.8",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "posthog-js": "^1.396.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-image-crop": "^11.1.2",
    "react-modal-sheet": "^5.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.107.0"
  }
}
